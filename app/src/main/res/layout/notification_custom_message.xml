<?xml version="1.0" encoding="utf-8"?>
<!--
  EduConnect Clean Message Notification Layout (Collapsed)
  Clean WhatsApp-style notification card with sender avatar, crisp typography, and zero duplicate app logos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_cm_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="90dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_notif_card"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- ── LEFT: Sender Avatar + Type Badge Overlay ─── -->
    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <ImageView
            android:id="@+id/notif_cm_app_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="Sender Avatar" />

        <ImageView
            android:id="@+id/notif_cm_badge"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="bottom|end"
            android:padding="4.5dp"
            android:background="@drawable/bg_notif_badge"
            android:src="@drawable/ic_badge_chat"
            android:scaleType="fitCenter"
            android:contentDescription="Type Badge" />
    </FrameLayout>

    <!-- ── RIGHT: Content ─── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <!-- Row 1: Sender Name + Relative Time + Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_cm_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sender"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_cm_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="now"
                android:textColor="#8E8CA0"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_chevron_down"
                android:contentDescription="Expand" />
        </LinearLayout>

        <!-- Row 2: Message Text (Left) + Clock Time (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3.5dp">

            <TextView
                android:id="@+id/notif_cm_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Message preview..."
                android:textColor="#D8D6EC"
                android:textSize="13.5sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_cm_msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:45 AM"
                android:textColor="#8E8CA0"
                android:textSize="11.5sp"
                android:paddingStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  EduConnect Clean Voice / Audio Playback Notification Layout
  Clean WhatsApp-style notification for voice message playback with sender avatar, live waveform, and zero duplicate app logos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_cv_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="90dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_notif_card"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- ── LEFT: Sender Avatar + Mic Badge Overlay ─── -->
    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <ImageView
            android:id="@+id/notif_cv_app_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="Voice Avatar" />

        <ImageView
            android:id="@+id/notif_cv_badge"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="bottom|end"
            android:padding="4.5dp"
            android:background="@drawable/bg_notif_badge"
            android:src="@drawable/ic_badge_mic"
            android:scaleType="fitCenter"
            android:contentDescription="Voice Badge" />
    </FrameLayout>

    <!-- ── RIGHT: Content ─── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <!-- Row 1: Sender Name + Relative Time + Chevron Down -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_cv_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sender"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_cv_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="now"
                android:textColor="#8E8CA0"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_chevron_down"
                android:contentDescription="Expand" />
        </LinearLayout>

        <!-- Row 2: [Play Circle] [Waveform Bars] [Duration] [Clock Time] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Play / Pause purple circular button -->
            <ImageView
                android:id="@+id/notif_cv_play_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_notif_play_circle"
                android:scaleType="fitCenter"
                android:contentDescription="Play / Pause" />

            <!-- Purple Waveform Bars (Dynamic Canvas-rendered Bitmap) -->
            <ImageView
                android:id="@+id/notif_cv_waveform"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitXY"
                android:contentDescription="Voice Waveform" />

            <!-- Duration (e.g. "0:18" or "0:05") -->
            <TextView
                android:id="@+id/notif_cv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:18"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Clock Time (e.g. "10:44 AM") -->
            <TextView
                android:id="@+id/notif_cv_msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:44 AM"
                android:textColor="#8E8CA0"
                android:textSize="11.5sp"
                android:paddingStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
